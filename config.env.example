# Copy this file to config.env and fill in your local credentials.
# Values in config.env override only when the same key isn't already present in the environment.

# --- Primary database (map data) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_golbat_user
DB_PASSWORD=your_golbat_password
DB_NAME=golbat
DB_SSL=false

# --- Discord notifications ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/token

# --- Discord OAuth (required for login) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override; defaults to http://localhost:4000/auth/discord/callback when omitted
DISCORD_REDIRECT_URI=
# Public base URL used to build callback when DISCORD_REDIRECT_URI is not set (e.g. https://example.com)
PUBLIC_BASE_URL=

# Session management
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_MS=604800000
SESSION_COOKIE_MAX_AGE_MS=604800000

# Optional remote config sync endpoint (set in production if used)
# LOCAL_CONFIG_URL=https://example.com:4700/area
# CONFIG_UPDATE_TOKEN=choose-a-strong-secret

# --- Koji database (geofence repository) ---
# Provide either a full connection URL or discrete credentials.
KOJI_DB_URL=
KOJI_DB_HOST=localhost
KOJI_DB_PORT=3306
KOJI_DB_USER=your_koji_user
KOJI_DB_PASSWORD=your_koji_password
KOJI_DB_NAME=koji
KOJI_DB_SSL=false

# Optional: override the relative path to your config file
# CONFIG_ENV_PATH=./config.env
